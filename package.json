{
  "name": "race-key",
  "private": true,
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @race-key/db generate",
    "db:push": "pnpm --filter @race-key/db push",
    "db:migrate": "pnpm --filter @race-key/db migrate",
    "db:seed": "pnpm --filter @race-key/db seed",
    "db:studio": "pnpm --filter @race-key/db studio",
    "e2e": "pnpm --filter @race-key/e2e e2e"
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "turbo": "^2.11.9",
    "typescript": "~6.0.3"
  }
}
