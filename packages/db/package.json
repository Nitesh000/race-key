{
  "name": "@race-key/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts"
  },
  "scripts": {
    "generate": "drizzle-kit generate",
    "push": "drizzle-kit push",
    "migrate": "tsx --import ./env.ts scripts/migrate.ts",
    "seed": "tsx --import ./env.ts scripts/seed.ts",
    "studio": "drizzle-kit studio",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "dev:db": "tsx scripts/local-db.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "@race-key/shared": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.9",
    "@race-key/config": "workspace:*",
    "@race-key/passages": "workspace:*",
    "@race-key/themes": "workspace:*",
    "@types/node": "^22.15.0",
    "drizzle-kit": "^0.31.11",
    "embedded-postgres": "^18.4.0-beta.17",
    "eslint": "^10.12.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.0.4"
  }
}
