# Postgres. Your Neon connection string, or a local Postgres from
#   pnpm --filter @race-key/db dev:db   ->   postgres://postgres:postgres@localhost:5433/postgres
DATABASE_URL=

# Better Auth (generate with: openssl rand -base64 32)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Optional social login
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Email (password reset, advertiser form)
RESEND_API_KEY=
EMAIL_FROM="race-key <hello@example.com>"
ADMIN_EMAIL=

# Realtime worker. The secret must match the worker's REALTIME_SHARED_SECRET.
# `next dev` falls back to the dev secret the worker also uses under `pnpm dev`.
NEXT_PUBLIC_REALTIME_URL=http://localhost:8787
REALTIME_SHARED_SECRET=

# Premium skins (Dodo Payments). Leave empty to keep purchases off, which you must do on
# Vercel Hobby. DODO_PRODUCTS maps skin ids to Dodo product ids.
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_KEY=
DODO_PAYMENTS_ENVIRONMENT=test_mode
DODO_PRODUCTS={"rocket":"pdt_...","ufo":"pdt_...","dragon":"pdt_..."}

# Ads. Off unless ADS_ENABLED=true, which you must not do on Vercel Hobby. Slots live in the
# ad_slots table (edit with `pnpm db:studio`).
ADS_ENABLED=false
NEXT_PUBLIC_ADSENSE_CLIENT=
