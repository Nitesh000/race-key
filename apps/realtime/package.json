{
  "name": "@race-key/realtime",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8787 --var ENVIRONMENT:development",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "lint": "eslint .",
    "typecheck": "wrangler types --include-runtime && tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "cf-typegen": "wrangler types --include-runtime"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@race-key/config": "workspace:*",
    "@types/node": "^22.15.0",
    "eslint": "^10.13.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.1"
  },
  "dependencies": {
    "@race-key/db": "workspace:*",
    "@race-key/passages": "workspace:*",
    "@race-key/shared": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "partyserver": "^0.5.10",
    "zod": "^4.6.7"
  }
}
