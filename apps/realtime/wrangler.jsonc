{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "race-key-realtime",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "vars": { "ENVIRONMENT": "production" },
  "triggers": { "crons": ["17 3 * * *"] },
  "durable_objects": {
    "bindings": [
      { "name": "RaceRoom", "class_name": "RaceRoom" },
      { "name": "Matchmaker", "class_name": "Matchmaker" },
      { "name": "Presence", "class_name": "Presence" },
    ],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RaceRoom"] },
    { "tag": "v2", "new_sqlite_classes": ["Matchmaker"] },
    { "tag": "v3", "new_sqlite_classes": ["Presence"] },
  ],
  "env": {
    "preview": {
      "name": "race-key-realtime-preview",
      "vars": { "ENVIRONMENT": "preview" },
      "durable_objects": {
        "bindings": [
          { "name": "RaceRoom", "class_name": "RaceRoom" },
          { "name": "Matchmaker", "class_name": "Matchmaker" },
          { "name": "Presence", "class_name": "Presence" },
        ],
      },
    },
  },
}
